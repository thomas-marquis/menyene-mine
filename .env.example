# Application Settings
APP_NAME=menyene-mine
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./menyene_mine.db

# AI Configuration (Optional)
# Set AI_ENABLED=true and provide MISTRAL_API_KEY to enable real AI recipe generation
# If not set, the system will use a mock generator for testing
AI_ENABLED=False
MISTRAL_API_KEY=your_mistral_api_key_here
AI_MODEL=mistral-medium
AI_MAX_DRAFTS=10
