# Local development environment variables for menyene-mine
# Copy this file to .env and fill in the values

# Mistral API Key (required for AI features)
MISTRAL_API_KEY=your_mistral_api_key_here

# Judge Model (optional, defaults to ai.model if not set)
JUDGE_MODEL=mistral-small-latest

# Database URL (optional, defaults to SQLite)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/menyene_mine
